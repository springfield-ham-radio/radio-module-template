{
  "name": "@springfield/radio-module-template",
  "version": "0.1.0",
  "description": "Starter template for a HamBench radio module (JSON driver). Replace the placeholder radio before publishing.",
  "author": "TODO",
  "license": "MIT",
  "readme": "README.md",
  "files": [
    "configs/",
    "src/shared/schemas/",
    "src/shared/memory-maps/"
  ],
  "type": "module",
  "exports": {
    "./configs/*": "./configs/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "ham-radio",
    "radio-module",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springfield-ham-radio/radio-module-template.git"
  },
  "scripts": {
    "build": "node -e \"console.log('json-only radio module; nothing to build')\"",
    "pack:release": "node scripts/pack-release-zip.mjs",
    "pack:beta": "ham-radio-pack-beta",
    "validate": "node scripts/validate-schemas.mjs",
    "check:driver-versions": "node scripts/check-driver-versions.mjs",
    "commitlint": "commitlint --edit",
    "format": "oxfmt",
    "lint": "oxlint test",
    "lint:fix": "oxlint --fix --fix-suggestions test",
    "release": "semantic-release",
    "prepare": "husky && yarn build",
    "test": "yarn test:unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "springfield": {
    "pluginType": "radio-module",
    "manufacturer": "TODO",
    "configPath": "configs",
    "sharedPath": "src/shared",
    "supportedRadios": [
      "example-radio"
    ],
    "capabilities": {
      "dslProtocols": true,
      "memoryRead": true,
      "memoryWrite": true,
      "channelProgramming": true,
      "settingsProgramming": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@springfield/ham-radio-api": "18.3.0",
    "@springfield/ham-radio-registry": "^2.1.0",
    "@springfield/ham-radio-utils": "^4.17.0",
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "loglayer": "^9.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "resolutions": {
    "conventional-changelog-conventionalcommits": "9.3.1",
    "loglayer": "9.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node scripts/pack-release-zip.mjs ${nextRelease.version}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "dist-release/radio-module-*.zip",
              "label": "Radio module JSON package (zip)"
            }
          ]
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ]
        }
      ]
    ]
  },
  "packageManager": "yarn@4.18.0"
}
